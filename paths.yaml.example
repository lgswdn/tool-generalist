# File paths for env_tool.py
# Edit this file to change asset locations without modifying code.

# DGN object dataset
dgn:
  candidates_json: /mnt/afs/zhuwenxuan/DGN/dev_minimal.json
  usd_dir: /mnt/afs/zhuwenxuan/DGN/coacd_usd
  obj_dir: /mnt/afs/zhuwenxuan/DGN/coacd_normalized

# End-effector tool dataset (legacy multi-tool paths, kept for reference)
tool:
  tools_json: /mnt/afs/zhuwenxuan/project/tool-generalist/RobotSmith/eef/tools_adjusted.json
  usd_dir: /mnt/afs/zhuwenxuan/project/tool-generalist/RobotSmith/eef/objects_usd
  obj_dir: /mnt/afs/zhuwenxuan/project/tool-generalist/RobotSmith/eef/normalized_models

# Fixed baked tool (fork baked into robot USD at panda_link7) — legacy single-tool
tool_mesh:
  obj_path: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/normalized_models/000_robotic_fork_effector_var_000.obj
  tools_json: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/tools_adjusted.json
  tool_name: 000_robotic_fork_effector_var_000
  scale: 0.1

# Multi-tool robot assets (multiple tool variants baked into separate robot USDs)
tools:
  robots_usd_dir: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/robots_usd
  tools_json: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/tools.json
  tools_selected_json: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/tools_selected.json
  obj_dir: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/RobotSmith/eef/normalized_models
  scale: 0.1

# Robot USD
robot:
  franka_usd: /mnt/afs/zhuwenxuan/project/inp/tool-generalist/bare_panda_instanceable.usd
