# Stage-1 frozen path schema.
# Copy to paths.yaml and replace example values with machine-local paths.
# Current runtime scripts may still read legacy keys until later phases.

objects:
  candidates_json: /path/to/objects/candidates.json
  usd_dir: /path/to/objects_usd
  obj_dir: /path/to/object_meshes

tools:
  # Tool point-cloud source of truth:
  #   <meshdata_adjusted_root>/<tool_id>/coacd/decomposed.obj
  meshdata_adjusted_root: /path/to/eef/meshdata_adjusted

  # Simulation assets, not point-cloud source of truth.
  objects_usd_root: /path/to/eef/objects_usd
  robots_usd_root: /path/to/Robots

  # Manifests.
  tools_adjusted_json: /path/to/eef/tools_adjusted.json
  tools_selected_json: /path/to/eef/tools_selected.json
  tool_asset_metadata_json: /path/to/eef/tool_asset_metadata.json

  # Source Franka asset tree used by the external tool asset pipeline.
  franka_src_root: /path/to/FrankaEmika

# Compatibility aliases documented for migration:
# - legacy dgn.* maps to objects.*
# - legacy tools.obj_dir points at normalized_models and is superseded by
#   tools.meshdata_adjusted_root plus {tool_id}/coacd/decomposed.obj
# - legacy tools.tools_json maps to tools.tools_adjusted_json
# - legacy tools.robots_usd_dir maps to tools.robots_usd_root
# - legacy tool_mesh.scale maps to GeneralCfg.franka_mount.scale_xyz
